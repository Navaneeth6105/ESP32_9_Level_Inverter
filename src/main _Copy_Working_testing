void IRAM_ATTR onTimerISR() {
  REG_WRITE(GPIO_OUT_REG, level_masks[idx]); //flip the output pins simultanouesly
  uint32_t start = XTHAL_GET_CCOUNT();   //test_purposes
  if (!burst_active) return;
  set_output();
  now[cycle_count] = cycle_count;
  if(mod_idx > 4000) mod_idx = 2000;
  sine_val = (int)(sine_lut[sine_idx] * mod_idx);
  level = -4;
  if (sine_val > tri_lut[0][tri_idx]) level++;
  if (sine_val > tri_lut[1][tri_idx]) level++;
  if (sine_val > tri_lut[2][tri_idx]) level++;
  if (sine_val > tri_lut[3][tri_idx]) level++;
  if (sine_val > tri_lut[4][tri_idx]) level++;
  if (sine_val > tri_lut[5][tri_idx]) level++;
  if (sine_val > tri_lut[6][tri_idx]) level++;
  if (sine_val > tri_lut[7][tri_idx]) level++;
  if(level == 0 && sine_val >= 0) level = 100;
  if(level == 0 && sine_val < 0) level = -100;
  if(level == -100) idx = 8;
  if(level == 100) idx = 9;
  else idx = level + 4;
  buffer[cycle_count] = level; 
  cycle_count++;
  sine_idx++;
  tri_idx++;
  if(sine_idx > 999) sine_idx=0;
  if(tri_idx > 9) tri_idx=0;
  if(cycle_count == test_samples){
     burst_active = false;
  }
    
  uint32_t end = XTHAL_GET_CCOUNT();
    uint32_t elapsed = end - start;
    
    if(elapsed < min_cycles) min_cycles = elapsed;
    if(elapsed > max_cycles) max_cycles = elapsed;
    total_cycles += elapsed;
    measurement_count++;

}

void setup() {
  pin_initialisation();
  REG_WRITE(GPIO_OUT_REG,0);
  digitalWrite(2,LOW);
  make_tri_lut();
  make_sine_lut();
  Serial.begin(115200);
  start_50kHz_timer();

}

void loop() {
  if(printed == false){
  
    for(int i = 0 ; i < test_samples ; i++){
      Serial.print(now[i]);
      Serial.print(",");
      Serial.println(buffer[i]);
    }
    digitalWrite(2,HIGH);
    printed = true;
    if(measurement_count >= 3000) {
        float cpu_freq = getCpuFrequencyMhz();
        
        Serial.printf("=== ISR Timing (%u iterations) ===\n", measurement_count);
        Serial.printf("CPU Frequency %f\n", cpu_freq);
        Serial.printf("Min:  %.2f us (%u cycles)\n", min_cycles / cpu_freq, min_cycles);
        Serial.printf("Max:  %.2f us (%u cycles)\n", max_cycles / cpu_freq, max_cycles);
        Serial.printf("Avg:  %.2f us (%u cycles)\n", (total_cycles / measurement_count) / cpu_freq, total_cycles / measurement_count);
        
        if(max_cycles / cpu_freq > 20.0) {
            Serial.printf("❌ WARNING: Max exceeds 20us budget!\n");
        } else {
            Serial.printf("✅ SAFE: Max within 20us budget\n");
        }
        
        // Reset for next test
        min_cycles = UINT32_MAX;
        max_cycles = 0;
        total_cycles = 0;
        measurement_count = 0;
      }
  
}
  vTaskDelay(pdMS_TO_TICKS(100));
}

void pin_initialisation(){
  pinMode(2,OUTPUT);
  pinMode(SWITCH_1, OUTPUT);
  pinMode(SWITCH_2, OUTPUT);
  pinMode(SWITCH_3, OUTPUT);
  pinMode(SWITCH_4, OUTPUT);
  pinMode(SWITCH_5, OUTPUT);
  pinMode(SWITCH_6, OUTPUT);
  pinMode(SWITCH_7, OUTPUT);
  pinMode(SWITCH_8, OUTPUT);
  pinMode(SWITCH_9, OUTPUT);
}

void start_50kHz_timer() {
    // 1. Create the timer
    // Timer 0, prescaler 80 (80 MHz / 80 = 1 MHz = 1µs per tick), count up
    timer_50kHz = timerBegin(0, 80, true);

    // 2. Attach your interrupt function
    timerAttachInterrupt(timer_50kHz, &onTimerISR, true);

    // 3. Set alarm to fire every 20 microseconds (1,000,000 µs / 50,000 Hz = 20 µs)
    //    true = auto-reload (periodic)
    timerAlarmWrite(timer_50kHz, 20, true);

    // 4. Start the timer
    timerAlarmEnable(timer_50kHz);
}

void make_tri_lut(){
  for(int i = 0 ; i < TRIANGLE_LUT_SIZE ; i++){
    tri_lut[0][i] = tri_lut[0][i] - 800000000;
  }
  for(int i = 1 ; i < CARRIER_NO_SIZE ; i++){
    for(int j = 0 ; j < TRIANGLE_LUT_SIZE ; j++)
      tri_lut[i][j] = tri_lut[i-1][j] + 200000000 ;
  }
}

void make_sine_lut(){
  for(int i = 0 ; i < SINE_LUT_SIZE ; i++){
    sine_lut[i] = (int)((sine_lut[i] - 800000000)*0.00025);
  }
}

